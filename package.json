{
  "name": "landing-estate",
  "private": true,
  "version": "0.1.0",
  "description": "Arabic-first RTL SaaS landing page builder for real estate marketers",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=10.33.2"
  },
  "scripts": {
    "dev:app": "pnpm --filter @landing-estate/app-worker dev",
    "dev:render": "pnpm --filter @landing-estate/render-worker dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:workers": "pnpm --filter @landing-estate/app-worker test && pnpm --filter @landing-estate/render-worker test",
    "test:e2e": "playwright test",
    "build": "pnpm -r build",
    "check": "pnpm typecheck && pnpm lint && pnpm check:boundaries && pnpm test && pnpm test:workers && pnpm test:e2e && pnpm build",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "workerd"]
  }
}
